# Local setup: everything runs on your machine. Copy to .env.ollama and start with
#   APP_PROFILE=ollama python -m support_agents.api
# Loaded after .env, so these values win.
DATABASE_URL=postgresql://support_app:support_dev_password@localhost:5432/support_fees
SUPERVISOR_PROVIDER=ollama
FINAL_RESPONSE_PROVIDER=ollama
ACADEMIC_AGENT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Ollama connection and models.
SUPERVISOR_OLLAMA_MODEL=qwen3:4b-instruct
FINAL_RESPONSE_OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ACADEMIC_AGENT_OLLAMA_MODEL=qwen3:4b-instruct
