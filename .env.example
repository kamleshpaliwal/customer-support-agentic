DATABASE_URL=postgresql://support_app:support_dev_password@localhost:5432/support_fees
# Supervisor model configuration (local development defaults).
SUPERVISOR_PROVIDER=ollama
SUPERVISOR_OLLAMA_MODEL=qwen3:4b-instruct
# FINAL_RESPONSE_PROVIDER and its model can be configured independently.
FINAL_RESPONSE_PROVIDER=ollama
FINAL_RESPONSE_OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ACADEMIC_DOCUMENT_PATH=data/academic/subjects_standards_1_to_10.pdf
ACADEMIC_BOOK_RECOMMENDATIONS_DOCUMENT_PATH=data/academic/ncert_book_recommendations_standards_1_to_10_2026-27.pdf
# Set a private random key to enable POST /api/v1/academic/ingest.
ACADEMIC_INGEST_API_KEY=
ACADEMIC_SEARCH_TOP_K=4
ACADEMIC_SEARCH_MIN_SIMILARITY=0.30
ACADEMIC_AGENT_OLLAMA_MODEL=qwen3:4b-instruct
# Use bedrock independently for either role when deploying.
AWS_REGION=us-east-1
SUPERVISOR_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
FINAL_RESPONSE_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Optional LangSmith observability. Keep disabled until you add your own API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-support-dev
# Set this only if your LangSmith workspace uses a non-default regional endpoint.
LANGSMITH_ENDPOINT=
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
