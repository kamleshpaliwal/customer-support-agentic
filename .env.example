# Setups: this file is the shared base. To switch between local (Ollama) and Amazon Bedrock without
# editing it, copy .env.ollama.example to .env.ollama and .env.bedrock.example to .env.bedrock,
# then start with APP_PROFILE=ollama or APP_PROFILE=bedrock. The profile file is loaded after
# .env, so its values win; with no APP_PROFILE only .env is used.
DATABASE_URL=postgresql://support_app:support_dev_password@localhost:5432/support_fees
# Supervisor model configuration (local development defaults).
SUPERVISOR_PROVIDER=ollama
SUPERVISOR_OLLAMA_MODEL=qwen3:4b-instruct
# FINAL_RESPONSE_PROVIDER and its model can be configured independently.
FINAL_RESPONSE_PROVIDER=ollama
FINAL_RESPONSE_OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ACADEMIC_DOCUMENT_PATH=data/academic/subjects_standards_1_to_10.pdf
ACADEMIC_BOOK_RECOMMENDATIONS_DOCUMENT_PATH=data/academic/ncert_book_recommendations_standards_1_to_10_2026-27.pdf
# Set a private random key to enable POST /api/v1/academic/ingest.
ACADEMIC_INGEST_API_KEY=
ACADEMIC_SEARCH_TOP_K=4
ACADEMIC_SEARCH_MIN_SIMILARITY=0.30
# Retrieval stages: vector | hybrid (adds Postgres full-text search); rerank needs the [rerank] extra.
# Embeddings: ollama (local nomic-embed-text, 768 dims) or bedrock (Titan V2). Vectors from
# different models are not comparable: re-ingest the documents after changing these.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_BEDROCK_DIMENSIONS=1024
ACADEMIC_RETRIEVAL_MODE=vector
ACADEMIC_CANDIDATE_POOL=20
ACADEMIC_RERANK_ENABLED=false
ACADEMIC_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Reranker backend: local (the cross-encoder above) or bedrock (Rerank API, no local model).
# Amazon Rerank 1.0 is not offered in us-east-1, so the Rerank API region is set separately.
RERANK_PROVIDER=local
RERANK_BEDROCK_MODEL_ID=amazon.rerank-v1:0
RERANK_BEDROCK_REGION=us-west-2
ACADEMIC_AGENT_PROVIDER=ollama
ACADEMIC_AGENT_OLLAMA_MODEL=qwen3:4b-instruct
# Use bedrock independently for each role when deploying.
AWS_REGION=us-east-1
# Local development only: keys of a dedicated IAM user with just bedrock:InvokeModel.
# Leave these empty in deployment; the service's IAM role is used instead. Without keys the app
# refuses to fall back to the default AWS CLI credentials (set AWS_ALLOW_CLI_PROFILE=true to
# allow that on purpose). Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ALLOW_CLI_PROFILE=false
SUPERVISOR_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# The academic agent needs a model that supports tool use through Converse.
ACADEMIC_AGENT_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
FINAL_RESPONSE_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Optional LangSmith observability. Keep disabled until you add your own API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-support-dev
# Set this only if your LangSmith workspace uses a non-default regional endpoint.
LANGSMITH_ENDPOINT=
# Authentication. Enabled by default and fail-closed: the server will not start without
# AUTH_ISSUER and AUTH_CLIENT_ID. Set AUTH_ENABLED=false only for local development.
AUTH_ENABLED=false
# AUTH_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# AUTH_CLIENT_ID=<app client id>
# AUTH_COGNITO_DOMAIN=<your-domain>.auth.<region>.amazoncognito.com
# AUTH_ALLOWED_GROUPS=staff,admin
# AUTH_ADMIN_GROUP=admin
# Overload protection. Per-user limit counts /query and /resume (0 disables it); it is shared
# by all workers when CHECKPOINT_BACKEND=postgres. MODEL_MAX_CONCURRENCY caps simultaneous model
# calls per process (0 = unlimited): extra calls wait up to MODEL_QUEUE_TIMEOUT_SECONDS, then
# the request gets HTTP 503. Match it to what Ollama / your Bedrock quota can serve.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MODEL_MAX_CONCURRENCY=4
MODEL_QUEUE_TIMEOUT_SECONDS=10
# postgres persists paused clarification sessions and pending MCP questions (shared by all workers); memory is for tests/single-process dev.
CHECKPOINT_BACKEND=postgres
# One long-lived MCP server process per API process (fast); false starts one per tool call.
MCP_PERSISTENT_SESSION=true
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
