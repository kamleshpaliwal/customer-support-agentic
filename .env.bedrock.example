# Amazon Bedrock setup. Copy to .env.bedrock and start with
#   BEDROCK_CALLS_ENABLED=true APP_PROFILE=bedrock python -m support_agents.api
# BEDROCK_CALLS_ENABLED is required in the real environment (it is ignored in .env files).
# Loaded after .env, so these values win. Use a database ingested with Titan embeddings.
DATABASE_URL=postgresql://support_app:support_dev_password@localhost:5432/support_fees_bedrock
SUPERVISOR_PROVIDER=bedrock
FINAL_RESPONSE_PROVIDER=bedrock
ACADEMIC_AGENT_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock
AWS_REGION=us-east-1
# Local development only: the keys of a dedicated IAM user that may call just the Bedrock models
# below. Put them here, never in the shared .env and never in a committed file. Leave them unset
# in deployment: the service's IAM role is used.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Models. The academic agent needs a model that supports tool use through Converse.
SUPERVISOR_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
FINAL_RESPONSE_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
ACADEMIC_AGENT_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Embeddings (Titan Text Embeddings V2: 256, 512 or 1024 dimensions).
EMBEDDING_BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_BEDROCK_DIMENSIONS=1024

# Optional Rerank API (only used if RERANK_PROVIDER=bedrock). Amazon Rerank 1.0 is not offered in
# us-east-1, so its region is set separately.
RERANK_BEDROCK_MODEL_ID=amazon.rerank-v1:0
RERANK_BEDROCK_REGION=us-west-2

# Without keys the app refuses to fall back to the default AWS CLI credentials; set this to true
# to allow that on purpose.
AWS_ALLOW_CLI_PROFILE=false
